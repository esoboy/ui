{
    "name": "esoboy/ui",
    "description": "Composable Blade components for Laravel 13 and Livewire 4.",
    "keywords": [
        "laravel",
        "livewire",
        "blade",
        "components",
        "ui",
        "shadcn"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.1",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "league/commonmark": "^2.10.7",
        "livewire/blaze": "^1.0",
        "livewire/livewire": "^4.4",
        "symfony/html-sanitizer": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Esoboy\\Ui\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Esoboy\\Ui\\UiServiceProvider"
            ]
        }
    }
}
